# ========================================================
# OpenWeatherMap API Configuration (Example Template)
# ========================================================
# 1. Sign up for a free account at: https://openweathermap.org/
# 2. Generate an API Key under: Profile -> 'My API Keys'
# 3. Copy this file as .env and replace with your actual key:
#    cp .env.example .env

OPENWEATHER_API_KEY=your_api_key_here
